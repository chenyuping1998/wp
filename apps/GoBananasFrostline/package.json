	"scripts": {
		"format": "prettier --write --ignore-path=../../.prettierignore .",
		"lint": "eslint \"src\"",
		"storybook": "PUBLIC_CHROMATIC=true storybook dev -p 6008 public",
		"dev": "vite dev --host --port 3008",
		"check:refs": "node design/check_undefined_refs.mjs",
		"check:social": "node design/check_social_words.mjs",
		"replay:harness": "node design/make_replay_harness.mjs",
