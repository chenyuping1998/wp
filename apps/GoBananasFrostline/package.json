		"preview": "vite preview",
		"check:meshwins": "node design/check_mesh_wins.mjs",
		"check:types": "node design/check_types.mjs",
		"check:anticipation": "node design/check_anticipation.mjs --report",
		"check:uirefs": "node design/check_ui_theme_refs.mjs --report",
		"check:frost": "node design/check_frost_takeover.mjs --report",
		"frame:frost": "node design/retheme_frame_frost.mjs \"E:/stake/tools/gen\"",
		"audio:frost": "node design/generate_audio_frost.mjs",
		"preview:freeze": "node design/preview_freeze.mjs \"E:/stake/tools/gen\""
	},
