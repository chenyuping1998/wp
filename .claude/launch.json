{
	"version": "0.0.1",
	"configurations": [
		{
			"name": "gobananas-dev",
			"runtimeExecutable": "pnpm",
			"runtimeArgs": ["--dir", "apps/GoBananas", "dev"],
			"port": 3002
		},
		{
			"name": "emberforge-dev",
			"runtimeExecutable": "pnpm",
			"runtimeArgs": ["--dir", "apps/EmberForge", "dev"],
			"port": 3003
		},
		{
			"name": "margincall-dev",
			"runtimeExecutable": "pnpm",
			"runtimeArgs": ["--dir", "apps/MarginCall", "exec", "vite", "dev", "--host", "--port", "3014"],
			"port": 3014
		},
		{
			"name": "wildparty-dev",
			"runtimeExecutable": "pnpm",
			"runtimeArgs": ["--dir", "apps/WildParty", "dev"],
			"port": 3001
		},
		{
			"name": "wildparty-storybook",
			"runtimeExecutable": "powershell",
			"runtimeArgs": [
				"-NoProfile",
				"-Command",
				"$env:PUBLIC_CHROMATIC='true'; pnpm --dir apps/WildParty exec storybook dev -p 6001 --ci"
			],
			"port": 6001
		}
	]
}
